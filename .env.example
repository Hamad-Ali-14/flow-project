# THIS FILE IS ONLY A TEMPLATE. Vite does NOT read .env.example.
# Copy the two VITE_SUPABASE_* lines into a file named .env.local (same folder as package.json).
# Put these in .env.local in the PROJECT ROOT (next to package.json), then RESTART `npm run dev`
# (Vite only reads env files at startup). Accepted alternatives: VITE_SUPABASE_PROJECT_URL,
# VITE_SUPABASE_PUBLISHABLE_KEY, VITE_SUPABASE_KEY.
# Use the ANON (public) key only.
# NEVER put the service_role key in a VITE_ variable: everything VITE_* is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional, development only: run on an in-memory sample station (NOT saved anywhere, resets on refresh).
# Without Supabase keys AND without this flag the app shows a "not connected" state and no tank data.
# VITE_DEMO_MODE=true

# Optional. Where a login is remembered: session (default: survives refresh, a fresh launch asks to sign in),
# none (always asks, even after refresh) or local (stay signed in across browser restarts).
# VITE_AUTH_PERSIST=session
